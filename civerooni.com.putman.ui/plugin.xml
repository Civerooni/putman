<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         id="product"
         point="org.eclipse.core.runtime.products">
      <product
            name="putman"
            application="org.eclipse.e4.ui.workbench.swt.E4Application">
         <property
               name="appName"
               value="putman">
         </property>
      </product>
   </extension>


   <extension point="org.eclipse.ui.views">
      <category
            id="civerooni.com.putman"
            name="Putman">
      </category>
      <view
            id="civerooni.com.putman.ui.views.PutmanView"
            name="Putman"
            category="civerooni.com.putman"
            class="civerooni.com.putman.ui.views.PutmanViewPart"
            restorable="true">
      </view>
   </extension>

</plugin>
